rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read; owner-only write.
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Public read (required for social feed); owner-only write.
    match /likedTracks/{uid}/tracks/{trackId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Public read; only the follower can create/delete their own follow doc.
    // followerId field in the document must match the caller's uid.
    match /follows/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.followerId == request.auth.uid;
    }

    // Public read; any authenticated user can write (like/unlike a song).
    match /songLikes/{trackId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Public read; authenticated user may only register a username pointing to their own uid.
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.data.uid == request.auth.uid;
    }

    // Referral codes — any authenticated user can read (for code-existence checks).
    // Any authenticated user can create (owner sets referrerId to their own uid).
    // Any authenticated user can update (new install adds themselves to installedUids).
    match /referrals/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.referrerId == request.auth.uid;
      allow update: if request.auth != null;
    }

    // Subscription records — owner read-only.
    // Writes are allowed for any authenticated user because recordReferralInstall
    // writes the referrer's discount from the new user's device (cross-uid write).
    // TODO: move reward grants to a Cloud Function to lock this down properly.
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null;
    }
  }
}
