rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated read; owner-only write — except the follow counter:
    // another signed-in user may change ONLY followerCount, by exactly 1,
    // and only while creating/deleting their own follow doc in the same
    // atomic batch (verified via existsAfter). Replaces the Cloud Function
    // path, which requires the Blaze plan to deploy.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
        && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['followerCount'])
        && (
          (request.resource.data.followerCount == resource.data.get('followerCount', 0) + 1
            && existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)))
          ||
          (request.resource.data.followerCount == resource.data.get('followerCount', 0) - 1
            && !existsAfter(/databases/$(database)/documents/follows/$(request.auth.uid + '_' + uid)))
        );
    }

    // Authenticated read (required for social feed); owner-only write.
    match /likedTracks/{uid}/tracks/{trackId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Public read; only the follower can create/delete their own follow doc.
    match /follows/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.followerId == request.auth.uid;
    }

    // Public read. likerCount may only move by exactly 1, in lockstep with the
    // caller's own liker doc in the same atomic write — no count vandalism.
    match /songLikes/{trackId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.get('likerCount', 0) <= 1;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likerCount', 'updatedAt'])
        && (
          (request.resource.data.likerCount == resource.data.get('likerCount', 0) + 1
            && existsAfter(/databases/$(database)/documents/songLikes/$(trackId)/likers/$(request.auth.uid)))
          ||
          (request.resource.data.likerCount == resource.data.get('likerCount', 0) - 1
            && !existsAfter(/databases/$(database)/documents/songLikes/$(trackId)/likers/$(request.auth.uid)))
        );
      allow delete: if false;
    }

    // Each liker gets their own doc — public read, owner create/delete only.
    match /songLikes/{trackId}/likers/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Public read; authenticated user may only register a username pointing to their own uid.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Referral codes — authenticated read; owner creates. Non-owners may only
    // register their own install, exactly once: installedUids grows by their
    // own uid, installCount by 1 (tier flags are cosmetic UI badges).
    match /referrals/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.referrerId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.referrerId == request.auth.uid
            || (request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['installedUids', 'installCount', 'updatedAt', 'tier1Rewarded', 'tier2Rewarded'])
                && !(request.auth.uid in resource.data.get('installedUids', []))
                && request.resource.data.installedUids.hasAll(resource.data.get('installedUids', []))
                && (request.auth.uid in request.resource.data.installedUids)
                && request.resource.data.installedUids.size()
                     == resource.data.get('installedUids', []).size() + 1
                && request.resource.data.installCount
                     == resource.data.get('installCount', 0) + 1));
      // Account deletion cleans up the user's own referral code.
      allow delete: if request.auth != null
                    && resource.data.referrerId == request.auth.uid;
    }

    // User/content reports -- create-only for clients (reviewed in console).
    match /reports/{reportId} {
      allow create: if request.auth != null
                    && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // Subscription records -- owner read/write only.
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Affiliate CRM -- authenticated read; clients may only register their own
    // install, exactly once (same shape as referrals above).
    match /affiliates/{code} {
      allow read: if request.auth != null;
      allow create: if false;
      allow delete: if false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['installedUids', 'installCount', 'updatedAt'])
        && !(request.auth.uid in resource.data.get('installedUids', []))
        && request.resource.data.installedUids.hasAll(resource.data.get('installedUids', []))
        && (request.auth.uid in request.resource.data.installedUids)
        && request.resource.data.installedUids.size()
             == resource.data.get('installedUids', []).size() + 1
        && request.resource.data.installCount
             == resource.data.get('installCount', 0) + 1;
    }
  }
}
