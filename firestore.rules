rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Authenticated read; owner-only write.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Authenticated read (required for social feed); owner-only write.
    match /likedTracks/{uid}/tracks/{trackId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Public read; only the follower can create/delete their own follow doc.
    match /follows/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.followerId == request.auth.uid;
    }

    // Public read; authenticated users may only update the like/unlike fields.
    match /songLikes/{trackId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likerUids', 'likerCount', 'updatedAt']);
      allow delete: if false;
    }

    // Public read; authenticated user may only register a username pointing to their own uid.
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
                    && resource.data.uid == request.auth.uid;
    }

    // Referral codes — authenticated read; owner creates; install-tracking fields only for others.
    match /referrals/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.referrerId == request.auth.uid;
      allow update: if request.auth != null
        && (resource.data.referrerId == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['installedUids', 'installCount', 'updatedAt']));
    }

    // Subscription records -- owner read/write only.
    match /subscriptions/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Affiliate CRM -- authenticated read; clients update install-tracking only.
    match /affiliates/{code} {
      allow read: if request.auth != null;
      allow create: if false;
      allow delete: if false;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['installedUids', 'installCount', 'updatedAt']);
    }
  }
}
