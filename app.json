{
  "expo": {
    "owner": "d00nny711",
    "name": "SongMatch",
    "slug": "SongMatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "songmatch",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "net.songmatch.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:songmatch.net"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withIOSFatalHandler",
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "SoundMatch needs access to your photo library to set a profile photo and banner."
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "WarmLight",
            "ios": "./assets/icons/warm_light.png"
          },
          {
            "name": "NeonGreen",
            "ios": "./assets/icons/neon_green.png"
          },
          {
            "name": "NeonPink",
            "ios": "./assets/icons/neon_pink.png"
          },
          {
            "name": "NeonCyan",
            "ios": "./assets/icons/neon_cyan.png"
          },
          {
            "name": "NeonOrange",
            "ios": "./assets/icons/neon_orange.png"
          },
          {
            "name": "IndigoViolet",
            "ios": "./assets/icons/indigo_violet.png"
          },
          {
            "name": "PinkCoral",
            "ios": "./assets/icons/pink_coral.png"
          },
          {
            "name": "OceanBlue",
            "ios": "./assets/icons/ocean_blue.png"
          },
          {
            "name": "MintTeal",
            "ios": "./assets/icons/mint_teal.png"
          },
          {
            "name": "StealthBlack",
            "ios": "./assets/icons/stealth_black.png"
          },
          {
            "name": "PureWhite",
            "ios": "./assets/icons/pure_white.png"
          },
          {
            "name": "GrapeSolid",
            "ios": "./assets/icons/grape_solid.png"
          },
          {
            "name": "MidnightNavy",
            "ios": "./assets/icons/midnight_navy.png"
          },
          {
            "name": "GoldBlack",
            "ios": "./assets/icons/gold_black.png"
          },
          {
            "name": "AllGold",
            "ios": "./assets/icons/all_gold.png"
          },
          {
            "name": "ChromeSilver",
            "ios": "./assets/icons/chrome_silver.png"
          },
          {
            "name": "BlackGoldBorder",
            "ios": "./assets/icons/black_gold_border.png"
          },
          {
            "name": "Lavender",
            "ios": "./assets/icons/lavender.png"
          },
          {
            "name": "BabyPink",
            "ios": "./assets/icons/baby_pink.png"
          },
          {
            "name": "SageGreen",
            "ios": "./assets/icons/sage_green.png"
          },
          {
            "name": "ButterYellow",
            "ios": "./assets/icons/butter_yellow.png"
          }
        ]
      ],
      "expo-image",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SongMatch to access your microphone to identify songs."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "android_app_id": "ca-app-pub-5279884722039690~5452090114",
          "ios_app_id": "ca-app-pub-5279884722039690~5452090114"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "adc8701a-14db-4a95-8ecb-28ce80db846c"
      }
    }
  }
}
